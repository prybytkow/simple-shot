{
  "name": "simple-shot",
  "version": "1.0.4",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc && node scripts/copy-build-assets.js",
    "start": "npm run build && electron .",
    "dev": "tsc-watch --onSuccess \"node scripts/copy-build-assets.js && electron .\"",
    "dist": "npm run build && electron-builder --win"
  },
  "build": {
    "appId": "com.simple-shot.app",
    "productName": "Simple Shot",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/koffi/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "dist/main/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "dist/main/assets/icon.ico",
      "uninstallerIcon": "dist/main/assets/icon.ico"
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/ssh2-sftp-client": "^9.0.6",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "tsc-watch": "^7.2.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1143.0",
    "@aws-sdk/s3-request-presigner": "^3.1143.0",
    "basic-ftp": "^6.2.1",
    "koffi": "^3.3.2",
    "ssh2-sftp-client": "^12.1.1"
  },
  "author": "Aliaksei Prybytkou",
  "license": "MIT",
  "description": "Simple Shot — screen capture and upload"
}
